#!/usr/bin/env python3
"""
nix-to-flatpak — Scan installed Nix packages and find Flatpak equivalents on Flathub.

Usage:
    nix-to-flatpak                    # scan system + user desktop apps
    nix-to-flatpak firefox vlc      # scan specific packages
    nix-to-flatpak --json             # output JSON

Builds a local cache of all Flathub apps via `flatpak remote-ls flathub --json`,
then matches installed Nix packages against it. No repeated network calls.
"""

import argparse
import json
import os
import re
import subprocess
import sys

CACHE_PATH = os.path.expanduser("~/.cache/nix-to-flatpak/flathub.json")
CACHE_MAX_AGE_HOURS = 24

# ── Discover installed packages ────────────────────────────────────────

DESKTOP_DIRS = [
    "/run/current-system/sw/share/applications",
    os.path.expanduser("~/.nix-profile/share/applications"),
    os.path.expanduser("~/.local/share/applications"),
]


def pkg_from_store_path(path):
    """Extract clean package name from /nix/store/... path."""
    if not path.startswith("/nix/store/"):
        return None
    tail = path.replace("/nix/store/", "")
    tail = re.sub(r'^[a-z0-9]{32}-', '', tail)
    m = re.match(r'^(.+?)-(?:unstable-)?(?:\d|git|v\d)', tail)
    return m.group(1) if m else tail.split("-")[0]


def get_installed_packages():
    """Return a set of installed package names from desktop files and store paths."""
    packages = set()

    # 1. Desktop files
    for d in DESKTOP_DIRS:
        if not os.path.isdir(d):
            continue
        for f in os.listdir(d):
            if not f.endswith(".desktop"):
                continue
            name = f[:-8]
            if any(skip in name for skip in ("-panel", "-settings", "gnome-control-center", "gnome-initial-setup")):
                continue
            packages.add(name)

    # 2. nix store paths (current system)
    try:
        result = subprocess.run(
            ["nix", "path-info", "-r", "/run/current-system"],
            capture_output=True, text=True, timeout=60
        )
        if result.returncode == 0:
            for line in result.stdout.strip().split("\n"):
                name = pkg_from_store_path(line.strip())
                if name:
                    packages.add(name)
    except FileNotFoundError:
        pass

    # 3. Home-manager if present
    hm = os.path.expanduser("~/.local/state/nix/profiles/home-manager")
    if os.path.islink(hm) or os.path.isdir(hm):
        try:
            result = subprocess.run(
                ["nix", "path-info", "-r", hm],
                capture_output=True, text=True, timeout=30
            )
            if result.returncode == 0:
                for line in result.stdout.strip().split("\n"):
                    name = pkg_from_store_path(line.strip())
                    if name:
                        packages.add(name)
        except FileNotFoundError:
            pass

    return packages


# ── Flathub cache ──────────────────────────────────────────────────────

def get_flathub_cache(force_refresh=False):
    """Return list of dicts with name + application_id from Flathub."""
    cache_valid = (
        os.path.isfile(CACHE_PATH) and
        not force_refresh and
        (os.path.getmtime(CACHE_PATH) > (os.time() if hasattr(os, 'time') else 0) - CACHE_MAX_AGE_HOURS * 3600)
    )

    if cache_valid:
        with open(CACHE_PATH, "r") as f:
            return json.load(f)

    print("Fetching Flathub app list... (this takes a moment)", file=sys.stderr)
    try:
        result = subprocess.run(
            ["flatpak", "remote-ls", "flathub", "--json"],
            capture_output=True, text=True, timeout=120
        )
    except FileNotFoundError:
        print("ERROR: flatpak not found. Install flatpak first.", file=sys.stderr)
        sys.exit(1)

    if result.returncode != 0:
        print(f"ERROR: flatpak remote-ls failed: {result.stderr}", file=sys.stderr)
        sys.exit(1)

    try:
        data = json.loads(result.stdout)
    except json.JSONDecodeError:
        print("ERROR: failed to parse flatpak output", file=sys.stderr)
        sys.exit(1)

    if not isinstance(data, list):
        print("ERROR: unexpected flatpak output format", file=sys.stderr)
        sys.exit(1)

    # Normalise: lower-case name and ID for fast matching
    cache = []
    for entry in data:
        cache.append({
            "name": entry.get("name", ""),
            "application_id": entry.get("application_id", ""),
            "name_lower": entry.get("name", "").lower(),
            "id_lower": entry.get("application_id", "").lower(),
        })

    os.makedirs(os.path.dirname(CACHE_PATH), exist_ok=True)
    with open(CACHE_PATH, "w") as f:
        json.dump(cache, f)

    return cache


# ── Desktop heuristic ──────────────────────────────────────────────────

DESKTOP_KEYWORDS = [
    "browser", "firefox", "chromium", "chrome", "brave", "opera", "vivaldi", "edge",
    "telegram", "discord", "signal", "element", "riot", "whatsapp", "thunderbird", "geary", "evolution",
    "vlc", "mpv", "obs", "studio", "spotify", "rhythmbox", "parabolic",
    "gimp", "inkscape", "blender", "krita", "darktable",
    "vscode", "code", "idea", "sublime", "zed", "lapce", "neovide",
    "libreoffice", "onlyoffice", "obsidian", "notion", "joplin", "logseq",
    "steam", "lutris", "wine", "heroic", "bottles",
    "qbittorrent", "transmission", "fragments",
    "nautilus", "dolphin", "thunar", "pcmanfm",
    "gtk", "gui", "desktop", "app", "client",
    "viewer", "editor", "player", "reader",
    "calculator", "calendar", "clock", "maps",
    "photo", "image", "video", "audio", "music",
    "pdf", "document", "spreadsheet", "notes",
    "foot", "alacritty", "wezterm", "kitty", "ghostty",
    "bitwarden", "keepass", "password",
    "zoom", "teams", "slack", "skype",
]


LIBRARY_BLOCKLIST = {
    "gtk", "gtk+", "gtk2", "gtk3", "gtk4", "gtk+3", "gtk+4",
    "qt", "qt5", "qt6", "qtbase", "qt5base", "qt6base",
    "appstream", "appstream-glib", "glib", "glibmm", "gobject", "gio",
    "cairo", "pango", "atk", "gdk", "gdk-pixbuf", "geoclue", "geoclue2",
    "libsecret", "libsoup", "libsoup3", "json-glib", "libnotify",
    "fontconfig", "freetype", "harfbuzz", "libpng", "libjpeg", "libtiff",
    "libxml2", "libxslt", "openssl", "curl", "zlib", "bzip2", "xz",
    "wayland", "wayland-protocols", "mesa", "vulkan", "vulkan-loader",
    "xorg", "xorg-server", "xlibs", "libx11", "libxext", "libxrender",
    "pipewire", "pulseaudio", "alsa", "alsa-lib", "jack2", "jack",
    "systemd", "elogind", "dbus", "dbus-glib", "polkit",
    "nss", "nspr", "icu", "sqlite", "postgresql", "mysql",
}


def is_desktop(name):
    # Skip common libraries entirely
    if name.lower() in LIBRARY_BLOCKLIST:
        return False
    n = name.lower()
    return any(kw in n for kw in DESKTOP_KEYWORDS)


# ── Matching ───────────────────────────────────────────────────────────

def find_matches(package_names, flathub_cache):
    """Match installed packages against the Flathub cache."""
    results = []
    seen_ids = set()

    for pkg in sorted(package_names):
        if not is_desktop(pkg):
            continue

        pkg_norm = re.sub(r'[^a-z0-9]', '', pkg.lower())

        # Skip plugins, base apps, SDKs, runtimes, themes, etc.
        skip_patterns = [
            ".plugin.", ".baseapp", ".base", "-base", ".sdk", ".runtime", ".extension.",
            ".theme.", ".icons.", ".fonts.", "-theme-", "-icon-",
            "gtk3theme", "gtk4theme", "gtk2theme",
        ]
        for entry in flathub_cache:
            app_id = entry["application_id"]
            if any(p in app_id.lower() for p in skip_patterns):
                continue
            # Case-insensitive: does the package name appear in the flatpak ID or display name?
            if pkg_norm in entry["id_lower"] or pkg_norm in entry["name_lower"]:
                if app_id not in seen_ids:
                    seen_ids.add(app_id)
                    results.append({
                        "nix_package": pkg,
                        "flatpak_id": app_id,
                        "flatpak_name": entry["name"],
                    })

    return results


# ── Output ─────────────────────────────────────────────────────────────

def print_results(results, json_mode=False):
    if json_mode:
        print(json.dumps(results, indent=2))
        return

    if not results:
        print("No Flatpak matches found for installed desktop packages.")
        return

    print(f"Found {len(results)} potential Flatpak replacement(s):\n")
    print("    services.flatpak.packages = [")
    for r in results:
        print(f'      "{r["flatpak_id"]}"  # {r["flatpak_name"]} (replaces nixpkgs:{r["nix_package"]})')
    print("    ];")
    print()
    print("Copy the above into your NixOS configuration under hardening.flatpak.enable.")


# ── Main ───────────────────────────────────────────────────────────────

def main():
    parser = argparse.ArgumentParser(
        description="Scan installed Nix packages and find Flatpak equivalents."
    )
    parser.add_argument("packages", nargs="*", help="Specific names to check")
    parser.add_argument("--json", action="store_true", help="JSON output")
    parser.add_argument("--all", action="store_true", help="Include non-desktop packages")
    parser.add_argument("--refresh", action="store_true", help="Rebuild the Flathub cache")
    args = parser.parse_args()

    if args.packages:
        packages = set(args.packages)
    else:
        packages = get_installed_packages()

    if not packages:
        print("ERROR: Could not determine installed packages.", file=sys.stderr)
        print("Run with explicit names: nix-to-flatpak firefox thunderbird", file=sys.stderr)
        sys.exit(1)

    if not args.all:
        packages = {p for p in packages if is_desktop(p)}

    flathub = get_flathub_cache(force_refresh=args.refresh)
    print(f"Scanning {len(packages)} desktop package(s) against {len(flathub)} Flathub apps...\n", file=sys.stderr)
    results = find_matches(packages, flathub)
    print_results(results, json_mode=args.json)


if __name__ == "__main__":
    main()
